{
 "elemod": 2,
 "id": "euclid-accents",
 "version": "1.2",
 "title": "Euclidean accents",
 "description": "Per track, the euclidean generator colours the pattern's own trigs with ACCENT instead of deciding which steps fire: the grid says when, euclid says what is accented. Bool Operator's range grows from OR, XOR, AND, SUB to eight values, each operator with an accent variant, so the setting is per track and saved with the pattern, in core-ar2's mod storage. Live behaviour, the FUNC-held bake and the plain revert are kept. Port of rytm-mods 0002-euclid-accents. From 1.2 Bool Operator's turn and text go through core-ar2 0.4's page tables (needs core 0.4, OS 1.74 only).",
 "category": "Sequencer",
 "author": "MrScruff (rytm-mods); elemod port: Iced-Cream",
 "license": "GPL-2.0-only",
 "target": {
  "device": "analog-rytm-mk2",
  "product": "Analog Rytm MKII",
  "os": "1.74",
  "syx_sha256": "cb0f99d620edde994fb860c0e79cc2464e427d06882828cfdfb00fc53700e123",
