{
 "elemod": 2,
 "id": "flexbus",
 "version": "1.0",
 "title": "Flex+ (Digitone machine)",
 "description": "Flex+, a Digitone mk1 machine that routes the external audio inputs (L, R or L+R) into a voice. The chosen input is pitch shifted -24..+24 semitones with the low-CPU Tone+FX SHFT two-grain shifter, then enters the track's filter, mixer, effects and AMP envelope as FM does. The SYN1 first page is a stock-like panel: four round controls in the bottom row (TUNE, GAIN, MIX, INPUT, with INPUT shown as two rows of text) and a small low-CPU oscilloscope above them, ported from DigiScope. One bus per track, last-note priority. Needs core-dn1 4.0 and machines 0.2, on OS 1.44.",
 "category": "Sound",
 "author": "x2k",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
  "os": "1.44",
  "syx_sha256": "d4f200d04484333d82822db7744e6484d0def8f2db8ddf55ee2b780cc13c9659",
