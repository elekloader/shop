{
 "elemod": 2,
 "id": "mutiny",
 "version": "0.2.1",
 "title": "MUTINY (Eurorack-style sequencers)",
 "description": "Euclidean, Turing Machine and TB-3PO acid sequencers from the Eurorack world on each Digitone mk1 synth track. Play them from the encoders and press YES to write a page into ordinary trigs. Unofficial and experimental: back up your projects first. Settings are saved per project.",
 "category": "Sequencer",
 "author": "mbaumannn",
 "license": "GPL-2.0-or-later",
