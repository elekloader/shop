{
 "elemod": 2,
 "id": "flexbus-dt",
 "version": "1.0",
 "title": "Flex+ (Digitakt machine)",
 "description": "Flex+, a Digitakt mk1 SRC machine that routes the external audio inputs and internal tracks into a track. A low-CPU pitch shifter (-24..+24 semitones), GAIN and MIX (dry/wet), and a scope across the SRC page top row. The selected input replaces the track's sample and then goes through the track's filter, amp envelope, level and FX as a sample does. The page uses the stock SLICE layout: A-D scope (display only), E TUNE, F GAIN, G MIX, H INPUT. Needs core 4.0 and machine-pages 1.1, on OS 1.54.",
 "category": "Sound",
 "author": "x2k",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitakt-mk1",
  "product": "Digitakt mk1",
  "os": "1.54",
  "syx_sha256": "f78ba80fa7b1da5fb0e1ff61ad61e9e71aafe79f4364fc49679f3651353e3cf6",
  "section3_sha256": "5c58bf9e3949ef09977c5fc007a61e8d026931f67f1621238379dfb8ee4d31a2",
  "section3_len": 2479680
 },
