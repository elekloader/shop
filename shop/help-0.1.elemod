{
 "elemod": 2,
 "id": "help",
 "version": "0.1",
 "title": "HELP: a mini manual for the mods in this build, on a master page",
 "description": "A master page (FUNC + LFO, HLP) listing the mods in this build, each with a short card of its keys and knobs. It looks for each mod's code, so only the mods you built in show. UP / DOWN or any knob choose and scroll, YES or a trig key opens a card, NO goes back to the list.",
 "category": "System",
 "author": "Cere, made with Claude",
 "license": "GPL-2.0-or-later",
