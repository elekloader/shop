{
 "elemod": 2,
 "id": "core",
 "version": "0.3.1",
 "title": "core",
 "description": "The boot copier and the hook bus for the Octatrack: it reserves the bottom of the sample and recorder memory for mods, only the 6 KB pages their RAM fills (0.2 took 10 MB), copies their code there at boot, and calls them on the UI tick, the screen, the keys, the encoders, MIDI in and the audio frame. Every linkable Octatrack mod needs it. On its own it changes nothing else the unit does.",
 "category": "Framework",
 "author": "irpina",
 "license": "GPL-2.0-or-later",
